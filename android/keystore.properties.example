# Play upload key for release builds.
#
# Copy to android/keystore.properties (git-ignored) and fill in real values.
# The same values can be supplied as environment variables in CI:
#   ABA_UPLOAD_STORE_FILE     -> KEYSTORE_FILE
#   ABA_UPLOAD_STORE_PASSWORD -> KEYSTORE_PASSWORD
#   ABA_UPLOAD_KEY_ALIAS      -> KEYSTORE_KEY_ALIAS
#   ABA_UPLOAD_KEY_PASSWORD   -> KEYSTORE_KEY_PASSWORD (defaults to the store password)
#
# Paths are resolved relative to the android/ directory; absolute paths also work.
#
# To create a new upload key:
#   keytool -genkeypair -v -keystore android/upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 4096 -validity 10000
#
# To find the alias inside an existing keystore:
#   keytool -list -v -keystore <path-to-keystore>
#
# Back the keystore and its passwords up somewhere durable. Losing them means
# losing the ability to ship updates for com.americabitcoinatm.wallet.

ABA_UPLOAD_STORE_FILE=upload-keystore.jks
ABA_UPLOAD_STORE_PASSWORD=
ABA_UPLOAD_KEY_ALIAS=upload
ABA_UPLOAD_KEY_PASSWORD=

# Caveat: with this file present, `assembleRelease` outputs app-release.apk
# instead of app-release-unsigned.apk. The fastlane APK lane handles both names,
# but tests/e2e/detox-build-release-apk.sh expects the unsigned name, so move
# this file aside before running the Detox release build locally.
